{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpa.dev/schema/ir/v0.1/workflow.schema.json",
  "title": "HPA Workflow IR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "workflowVersion", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "hpa.dev/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "workflowVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/io" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/io" } },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "triggers": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
    "policies": { "$ref": "#/$defs/policies" },
    "errorHandling": { "$ref": "#/$defs/errorHandling" },
    "retry": { "$ref": "#/$defs/retry" },
    "timeout": { "$ref": "#/$defs/timeout" },
    "subflows": { "type": "array", "items": { "$ref": "#/$defs/subflow" } },
    "layout": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$" },
        "type": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": true,
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$" },
        "type": { "type": "string" },
        "initial": true,
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "expr": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["$expr"], "properties": { "$expr": { "type": "string", "minLength": 1, "maxLength": 20000 } } },
        { "required": ["$template"], "properties": { "$template": { "type": "string", "minLength": 1, "maxLength": 20000 } } }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "typeVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "typeVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "config": { "type": "object" },
        "inputMapping": { "type": "object" },
        "outputSchema": { "type": "object" },
        "retry": { "$ref": "#/$defs/retry" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "errorPolicy": { "$ref": "#/$defs/errorPolicy" },
        "permissions": { "type": "object" },
        "ui": { "type": "object" },
        "body": { "$ref": "#/$defs/graph" },
        "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/branch" } }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "source": { "type": "string" },
        "sourcePort": { "type": "string", "default": "out" },
        "target": { "type": "string" },
        "targetPort": { "type": "string", "default": "in" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "graph"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "graph": { "$ref": "#/$defs/graph" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 1 },
        "backoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["constant", "linear", "exponential"], "default": "exponential" },
            "baseMs": { "type": "integer", "minimum": 1, "default": 500 },
            "maxMs": { "type": "integer", "minimum": 1, "default": 10000 },
            "jitter": { "type": "boolean", "default": true }
          }
        },
        "retryOn": { "type": "array", "items": { "type": "string" } },
        "nonRetryable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "errorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["fail", "skip", "continue", "fallback", "compensate"] },
        "fallbackPort": { "type": ["string", "null"] },
        "compensationNodeId": { "type": ["string", "null"] }
      }
    },
    "errorHandling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["graph", "fail"], "default": "fail" },
        "graph": { "$ref": "#/$defs/graph" }
      }
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionMs": { "type": "integer", "minimum": 1 }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durability": { "type": "string", "enum": ["standard", "durable"], "default": "standard" },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1 }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxCostUsd": { "type": "number", "minimum": 0 },
            "maxTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low" },
        "dataRetentionDays": { "type": "integer", "minimum": 1 },
        "approval": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "type": { "type": "string", "enum": ["schedule", "webhook", "event", "mcp"] },
        "config": { "type": "object" }
      }
    },
    "subflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "graph"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/io" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/io" } },
        "graph": { "$ref": "#/$defs/graph" }
      }
    }
  }
}
