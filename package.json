{
  "name": "hpa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "check:brand": "node scripts/check-brand.mjs",
    "check:ir": "node scripts/check-ir.cjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:mirrors": "node scripts/check-domestic-mirrors.mjs",
    "check:otel": "node scripts/check-otel-config.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:audit": "pnpm audit --audit-level moderate --registry=https://registry.npmjs.org",
    "check": "npm run check:brand && npm run check:ir && npm run check:contracts && npm run check:docs && npm run check:mirrors && npm run check:otel && npm run check:supply-chain && npm run check:audit",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:a11y": "node scripts/check-web-a11y.mjs",
    "test:e2e": "node scripts/run-local-e2e.mjs",
    "test:approval-branches": "node scripts/approval-branches-e2e.mjs",
    "test:marketplace-ui": "node scripts/phase13-marketplace-ui-e2e.mjs",
    "test:ai-worker-container": "node scripts/phase13-ai-worker-container-smoke.mjs",
    "test:scim-e2e": "node scripts/scim-e2e.mjs",
    "test:mcp-conformance": "node scripts/mcp-conformance.mjs",
    "test:mcp-conformance:2026": "HPA_CONFORMANCE_SPEC_VERSION=2026-07-28 HPA_CONFORMANCE_SCENARIOS=server-stateless node scripts/mcp-conformance.mjs",
    "test:mcp-conformance:2026-content": "HPA_CONFORMANCE_SPEC_VERSION=2026-07-28 HPA_CONFORMANCE_SCENARIOS=tools-call-image,tools-call-audio,tools-call-embedded-resource,tools-call-mixed-content,tools-call-with-progress,resources-list,resources-read-text,resources-read-binary,resources-templates-read,prompts-get-simple,prompts-get-with-args,prompts-get-embedded-resource,prompts-get-with-image,completion-complete,caching,json-schema-2020-12,http-header-validation,http-custom-header-server-validation node scripts/mcp-conformance.mjs",
    "test:mcp-conformance:2026-mrtr": "HPA_CONFORMANCE_SPEC_VERSION=2026-07-28 HPA_CONFORMANCE_SCENARIOS=input-required-result-basic-elicitation,input-required-result-basic-sampling,input-required-result-basic-list-roots,input-required-result-request-state,input-required-result-multiple-input-requests,input-required-result-multi-round,input-required-result-missing-input-response,input-required-result-non-tool-request,input-required-result-result-type,input-required-result-unsupported-methods,input-required-result-tampered-state,input-required-result-capability-check,input-required-result-ignore-extra-params,input-required-result-validate-input node scripts/mcp-conformance.mjs",
    "test:mcp-conformance:2026-tasks": "HPA_CONFORMANCE_FORCE=1 HPA_CONFORMANCE_SPEC_VERSION=2026-07-28 HPA_CONFORMANCE_SCENARIOS=tasks-lifecycle,tasks-capability-negotiation,tasks-wire-fields,tasks-request-state-removal,tasks-mrtr-input,tasks-request-headers,tasks-dispatch-and-envelope,tasks-status-notifications,tasks-required-task-error,tasks-mrtr-composition node scripts/mcp-conformance.mjs",
    "test:multi-node": "node scripts/multi-node-e2e.mjs",
    "test:rolling": "node scripts/rolling-restart-e2e.mjs",
    "test:worker-rolling": "node scripts/worker-rolling-upgrade-e2e.mjs",
    "test:ha": "bash scripts/postgres-replica-failover-e2e.sh",
    "test:postgres": "bash scripts/run-postgres-tests.sh",
    "test:postgres:backup": "node scripts/check-postgres-backup.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
